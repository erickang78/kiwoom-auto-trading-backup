[Unit]
Description=Kiwoom read-only dashboard refresh API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/kiwoom/current
ExecStart=/opt/kiwoom/.venv/bin/python /opt/kiwoom/current/refresh_api.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/kiwoom/current /opt/kiwoom/secrets

[Install]
WantedBy=multi-user.target
